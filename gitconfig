[user]
	email = jasongprasad@gmail.com
	name = Jason Prasad
[init]
	defaultBranch = main
[credential]
	helper = osxkeychain
# generated by: git lfs install --skip-repo
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[include]
	path = ~/.gitconfig.local
